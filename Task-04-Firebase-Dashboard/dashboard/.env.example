# Firebase web app config (Project settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Adafruit IO — account-wide key. Anything VITE_* is shipped to the browser, so this is the
# documented trade-off from the write-up (see ../README.md). Leave blank to disable the Adafruit toggle.
VITE_AIO_USERNAME=
VITE_AIO_KEY=
